android_app {
    name: "DumbdroidAdmin",
    srcs: [
        "src/main/java/eu/dumbdroid/deviceowner/**/*.kt",
    ],
    resource_dirs: ["res"],
    manifest: "AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    required: ["dumberos-domain-blocklist.rc"],
    static_libs: [
        "androidx.appcompat_appcompat",
    ],
}

prebuilt_etc {
    name: "dumberos-domain-blocklist.rc",
    src: "init/dumberos-domain-blocklist.rc",
    sub_dir: "init",
}
